# MathPIX API
MATHPIX_APP_ID=your_app_id
MATHPIX_APP_KEY=your_app_key

# Gemini API
GEMINI_API_KEY=your_gemini_key

# OpenAI API
OPENAI_API_KEY=your_openai_key

# AWS S3 CDN (for image upload)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=your_bucket_name
AWS_S3_REGION=ap-south-1

# Database reference (existing questions for duplicate check)
DB_PATH=D:\ACADZA_WORK\PROOF-READING_v2.0\allque140126.json

# Global FAISS index cache (pre-built embeddings for 160K questions)
# Avoids ~$5 re-embedding cost. Copy from data/db_index_cache/ or generate once.
DB_INDEX_DIR=data/db_index_cache

# Concept tree + tagging modules
CONCEPT_TREE_PATH=D:\ACADZA_WORK\PCM_Batches\acadza_concept_tree.json
TAGGING_MODULES_DIR=D:\ACADZA_WORK\PCM_Batches
