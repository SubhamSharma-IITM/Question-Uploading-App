# ── Acadza API Auth (Stage 6: CDN Upload, Stage 10: DB Upload) ──
ACADZA_API_USERNAME=your_phone_or_username
ACADZA_API_PASSWORD=your_password

# OCR Engine selection (mathpix or mineru)
OCR_ENGINE=mineru

# MathPIX API (Stage 1: PDF OCR)
MATHPIX_APP_ID=your_app_id
MATHPIX_APP_KEY=your_app_key

# MinerU API Token () Obtain from https://mineru.net/apiManage
MINERU_TOKEN=your_mineru_token

# Gemini API (Stage 2: LLM Mapper, Stage 9: QA Pass 1 via AI Studio fallback)
GEMINI_API_KEY=your_gemini_key

# OpenAI API (Stage 7: Tagging embeddings, Stage 8: Duplicate embeddings, Stage 9: QA Pass 2/3)
OPENAI_API_KEY=your_openai_key
# Anthropic API (Stage 2: Claude mapper alternative)
ANTHROPIC_API_KEY=your_anthropic_key

# ── Vertex AI (Stage 9: QA Pass 1 PRIMARY — paid quota, no 429 issues) ──
# Service account JSON file path (download from GCP Console → IAM → Service Accounts)
VERTEX_AI_CREDENTIALS=your_service_account.json
# GCP project ID (from the service account)
VERTEX_AI_PROJECT=your_project_id
# Region (default: global) 
VERTEX_AI_LOCATION=global
# GCS bucket for batch I/O (must exist, service account needs Storage Admin)
VERTEX_AI_BUCKET=your_gcs_bucket_name



# ── AWS S3 (Stage 6: Image CDN Upload) ──
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=your_bucket_name

# ── Video Service API Token (Bearer auth for all /video/* endpoints) ──
VIDEO_API_TOKEN=your_video_api_token_here

# ── Paths (all bundled in repo by default — override only if needed) ──
# DB_PATH=data/allque030326.json
# DB_INDEX_DIR=data/db_index_cache
# TAGGING_MODULES_DIR=data/tagging_modules
# CONCEPT_TREE_PATH=data/acadza_concept_tree.json

# ── Stage 11 nightly conversion (err=2 -> err=1 LLM correction loop) ──
# ALL times below are STRICTLY IST (Asia/Kolkata, UTC+5:30). Internally the
# scheduler uses IST for trigger times, cohort date filtering, and history
# attribution -- never UTC or server-local time.
#
# When STAGE11_NIGHTLY_ENABLED=true, an in-app asyncio sleeper fires at
# STAGE11_TRIGGER_HOUR_IST:STAGE11_TRIGGER_MIN_IST IST each night.
#
# Cohort = (previous IST day's err=2 uploads via combined_upload_log.csv)
#        + (any prior date's failed_retry from data/stage11_history.json)
# Floor  = STAGE11_FLOOR_DATE. Older err=2 NOT swept by nightly.
#
# Example: floor 2026-05-18 + trigger 19-May 00:30 IST processes the err=2
# OIDs from 18-May (00:00-23:59 IST). Then 20-May 00:30 IST covers 19-May.
#
# DRYRUN=true: scheduler selects cohort, runs multiget verify, writes the
# {date}.json report -- but skips all live PUT calls. Useful for a no-write
# first-night canary.
STAGE11_NIGHTLY_ENABLED=false
STAGE11_FLOOR_DATE=2026-05-18
STAGE11_TRIGGER_HOUR_IST=0
STAGE11_TRIGGER_MIN_IST=30
STAGE11_DRYRUN=false
