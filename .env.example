# MathPIX API (Stage 1: PDF OCR)
MATHPIX_APP_ID=your_app_id
MATHPIX_APP_KEY=your_app_key

# Gemini API (Stage 2: LLM Mapper, Stage 9: QA Pass 1)
GEMINI_API_KEY=your_gemini_key

# OpenAI API (Stage 7: Tagging embeddings, Stage 8: Duplicate embeddings, Stage 9: QA Pass 2/3)
OPENAI_API_KEY=your_openai_key

# Anthropic API (Stage 2: Claude mapper alternative)
ANTHROPIC_API_KEY=your_anthropic_key

# AWS S3 CDN (currently unused — image upload uses api.acadza.in endpoint, no keys needed)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_BUCKET=your_bucket_name
# AWS_S3_REGION=ap-south-1

# ── Paths (MUST be set per machine) ──

# Database reference — JSONL file with 162K existing questions (for Stage 8 duplicate check + Stage 10 absorption)
DB_PATH=D:\ACADZA_WORK\data\allque030326.json

# Global FAISS index cache — pre-built embeddings for 160K questions
# Avoids ~$5 re-embedding cost on first cross-duplicate check. Auto-generated if missing.
DB_INDEX_DIR=data/db_index_cache

# Tagging modules — directory containing {subject}_tagging_module/ subdirs
# Each subdir needs: {subject}_faiss_index.idx + {subject}_chunk_data.json
# Subjects: physics, chemistry, math, biology
TAGGING_MODULES_DIR=D:\ACADZA_WORK\PCM_Batches

# Concept tree — JSON ontology file for Stage 9 QA validation
CONCEPT_TREE_PATH=D:\ACADZA_WORK\PCM_Batches\acadza_concept_tree.json
